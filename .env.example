# Get these from https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# Web UI port (8080 works without extra caps; use 80 + open SG port 80 if you prefer)
WEB_PORT=8080

# Dashboard unlock (default alphafx if unset)
# APP_PASSWORD=alphafx

# Channel: @username, t.me link slug, or numeric id like -1001234567890
# https://t.me/AbeidFXTelegramChannel
CHANNEL=@AbeidFXTelegramChannel

# Optional: how many recent messages to fetch (default 20) — check_channel.py only
LIMIT=20

# Headless EC2: paste output from login_session.py (recommended on servers)
# SESSION_STRING=

# Legacy CLI watcher only (not the web dashboard poll)
POLL_HEARTBEAT_SECONDS=0

# MT5 HTTP API (watch_channel.py) — keep DRY_RUN until your API is wired
MT5_API_URL=http://127.0.0.1:8080
# MT5_API_KEY=
MT5_OPEN_PATH=/order
MT5_CLOSE_PATH=/order
MT5_AUTO_TRADE=false
MT5_DRY_RUN=true
SL_FRAGMENT_WINDOW_SEC=180

# Capiffy prop firm — copy from DevTools on a trade request (e.g. POST /api/trade/open):
#   authorization: Bearer …     → CAPIFFY_ACCESS_TOKEN (short-lived ~15 min)
#   Cookie refreshToken=…     → CAPIFFY_REFRESH_TOKEN (~7 days; used to refresh access)
#   x-device-cid: …            → CAPIFFY_DEVICE_CID
#   JSON accountId             → CAPIFFY_ACCOUNT_ID
# CAPIFFY_ACCESS_TOKEN=
# CAPIFFY_REFRESH_TOKEN=
# CAPIFFY_DEVICE_CID=
# CAPIFFY_ACCOUNT_ID=
# CAPIFFY_REFRESH_URL=https://api.capiffy.com/api/auth/refresh
