# Get these from https://my.telegram.org/apps
API_ID=27145483

API_HASH=77e86060b0658db6c5f81a9e0174554f

# Channel: @username, t.me link slug, or numeric id like -1001234567890
# https://t.me/AbeidFXTelegramChannel
CHANNEL=@AbeidFXTelegramChannel

# Optional: how many recent messages to fetch (default 20) — check_channel.py only
LIMIT=20

# Headless EC2: paste output from login_session.py (recommended on servers)
# SESSION_STRING=

# Optional: heartbeat log interval for watch_channel.py daemon (0 = off)
POLL_HEARTBEAT_SECONDS=300

# MT5 HTTP API (watch_channel.py) — keep DRY_RUN until your API is wired
MT5_API_URL=http://127.0.0.1:8080
# MT5_API_KEY=
MT5_OPEN_PATH=/order
MT5_CLOSE_PATH=/order
MT5_AUTO_TRADE=false
MT5_DRY_RUN=true
SL_FRAGMENT_WINDOW_SEC=180
